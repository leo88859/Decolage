# Copie ce fichier en .env.local (en local) ou dans Vercel → Settings → Environment Variables.
# Sans ces variables, Décollage fonctionne en mode local (projets dans le navigateur, sans comptes ni paiement).

# ── Supabase (comptes, sauvegarde en ligne, sites publiés, listes d'attente) ──
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secrète : webhook Stripe et suppression de compte. Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (abonnements Solo, Pro et Illimité de Décollage) ──
# Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=
# Stripe → Développeurs → Webhooks → ton endpoint → Clé de signature
STRIPE_WEBHOOK_SECRET=
# Stripe → Catalogue de produits → identifiant de chaque prix mensuel (price_...)
STRIPE_PRICE_SOLO=        # 2,99 € / mois — 1 projet
STRIPE_PRICE_PRO=         # 9,99 € / mois — 5 projets
STRIPE_PRICE_ILLIMITE=    # 29,99 € / mois — projets illimités

# ── Adresse publique du site (sans / final) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Marque blanche (facultatif, serveur uniquement, jamais NEXT_PUBLIC_) ──
# Identifiants utilisateur (UUID, séparés par des virgules) autorisés à tester la marque blanche sans ligne
# dans brand_entitlements. La source normale du droit est la table brand_entitlements (voir docs/MARQUE-BLANCHE.md).
WHITE_LABEL_USER_IDS=
